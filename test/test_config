"""
测试 src/config.py

覆盖：
1. 正常配置全部字段
2. 缺 API Key 时 get_config 正常返回（延迟校验）
3. 缺 API Key 时 require_api_key 报错
4. RETRIEVE_TOP_K = 0 报错
5. CHUNK_OVERLAP >= CHUNK_SIZE 报错
6. EMBEDDING_PROVIDER 非法值报错
7. 价格为 0 允许
8. 价格为负报错
9. MEMORY_TURNS = 0 报错
10. 非整数配置报错
"""

import pytest

from src.config import get_config, require_api_key


class TestConfigNormal:
    def test_valid_config_returns_all_fields(self, valid_env):
        cfg = get_config()
        assert cfg.deepseek_api_key == "sk-test-key"
        assert cfg.deepseek_model == "deepseek-chat"
        assert cfg.deepseek_base_url == "https://api.deepseek.com"
        assert cfg.input_price_per_1m == 1.00
        assert cfg.output_price_per_1m == 2.00
        assert cfg.embedding_provider == "local"
        assert cfg.retrieve_top_k == 3
        assert cfg.chunk_size == 500
        assert cfg.chunk_overlap == 80
        assert cfg.memory_turns == 6

    def test_config_uses_defaults_when_missing(self, clean_env):
        cfg = get_config()
        assert cfg.deepseek_model == "deepseek-chat"
        assert cfg.retrieve_top_k == 3
        assert cfg.embedding_provider == "local"


class TestApiKey:
    def test_missing_api_key_still_returns_config(self, clean_env):
        """延迟校验：get_config 不应因缺 key 崩溃。"""
        cfg = get_config()
        assert cfg.deepseek_api_key == ""

    def test_require_api_key_raises_when_missing(self, clean_env):
        with pytest.raises(RuntimeError, match="DEEPSEEK_API_KEY"):
            require_api_key()

    def test_require_api_key_returns_when_present(self, valid_env):
        assert require_api_key() == "sk-test-key"


class TestInvalidNumeric:
    def test_retrieve_top_k_zero_raises(self, valid_env):
        valid_env.setenv("RETRIEVE_TOP_K", "0")
        with pytest.raises(ValueError, match="RETRIEVE_TOP_K"):
            get_config()

    def test_retrieve_top_k_negative_raises(self, valid_env):
        valid_env.setenv("RETRIEVE_TOP_K", "-1")
        with pytest.raises(ValueError, match="RETRIEVE_TOP_K"):
            get_config()

    def test_memory_turns_zero_raises(self, valid_env):
        valid_env.setenv("MEMORY_TURNS", "0")
        with pytest.raises(ValueError, match="MEMORY_TURNS"):
            get_config()

    def test_chunk_overlap_greater_than_chunk_size_raises(self, valid_env):
        valid_env.setenv("CHUNK_SIZE", "500")
        valid_env.setenv("CHUNK_OVERLAP", "600")
        with pytest.raises(ValueError, match="CHUNK_OVERLAP"):
            get_config()

    def test_chunk_size_too_large_raises(self, valid_env):
        valid_env.setenv("CHUNK_SIZE", "99999")
        with pytest.raises(ValueError, match="CHUNK_SIZE"):
            get_config()

    def test_non_integer_config_raises(self, valid_env):
        valid_env.setenv("RETRIEVE_TOP_K", "abc")
        with pytest.raises(ValueError, match="必须是整数"):
            get_config()


class TestPrice:
    def test_price_zero_allowed(self, valid_env):
        valid_env.setenv("DEEPSEEK_INPUT_PRICE_PER_1M", "0")
        valid_env.setenv("DEEPSEEK_OUTPUT_PRICE_PER_1M", "0")
        cfg = get_config()
        assert cfg.input_price_per_1m == 0.0
        assert cfg.output_price_per_1m == 0.0

    def test_negative_price_raises(self, valid_env):
        valid_env.setenv("DEEPSEEK_INPUT_PRICE_PER_1M", "-1")
        with pytest.raises(ValueError, match="DEEPSEEK_INPUT_PRICE_PER_1M"):
            get_config()

    def test_non_numeric_price_raises(self, valid_env):
        valid_env.setenv("DEEPSEEK_INPUT_PRICE_PER_1M", "xyz")
        with pytest.raises(ValueError, match="必须是数字"):
            get_config()


class TestEmbeddingProvider:
    def test_invalid_provider_raises(self, valid_env):
        valid_env.setenv("EMBEDDING_PROVIDER", "openai")
        with pytest.raises(ValueError, match="EMBEDDING_PROVIDER"):
            get_config()

    def test_provider_case_insensitive(self, valid_env):
        valid_env.setenv("EMBEDDING_PROVIDER", "LOCAL")
        cfg = get_config()
        assert cfg.embedding_provider == "local"